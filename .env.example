# Copy to .env and fill in. Never commit the real .env.

# Home Assistant address as reachable from the printlog container.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: Home Assistant → your profile → Security → Create token.
HA_TOKEN=

# Optional
# TZ=Europe/Berlin
# PRINTLOG_PORT=8095
# PRICE_ENTITY=input_number.strompreis
# BACKUP_DIR=/backup
# BACKUP_HOUR=3
